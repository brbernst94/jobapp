{
  "manifest_version": 3,
  "name": "JobApp Gmail Tracker",
  "version": "1.0.0",
  "description": "Tracks job application responses in Gmail by company domain and updates Patrick Selner's JobApp dashboard automatically.",
  "permissions": [
    "identity",
    "alarms",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobApp Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "oauth2": {
    "client_id": "YOUR_GMAIL_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.readonly",
      "https://www.googleapis.com/auth/gmail.modify"
    ]
  }
}
